pipeline {
agent any

```
environment {
    IMAGE_NAME = "swaroop2910/taskmanager-backend"
    BACKEND_CHANGED = "false"
}

stages {

    stage('Check Backend Changes') {
        steps {
            script {

                def changedFiles = sh(
                    script: 'git diff --name-only HEAD~1 HEAD',
                    returnStdout: true
                ).trim()

                echo "Changed Files:"
                echo changedFiles

                if (changedFiles.contains('product_backend/')) {
                    env.BACKEND_CHANGED = "true"
                    echo "Backend changes detected"
                } else {
                    echo "No backend changes detected"
                }
            }
        }
    }

    stage('Workspace Check') {
        when {
            expression {
                env.BACKEND_CHANGED == "true"
            }
        }

        steps {
            sh 'pwd'
            sh 'ls -la'
        }
    }

    stage('Build Docker Image') {
        when {
            expression {
                env.BACKEND_CHANGED == "true"
            }
        }

        steps {
            sh '''
                docker build \
                -t ${IMAGE_NAME}:latest \
                -t ${IMAGE_NAME}:${BUILD_NUMBER} \
                ./product_backend
            '''
        }
    }

    stage('Verify Image') {
        when {
            expression {
                env.BACKEND_CHANGED == "true"
            }
        }

        steps {
            sh 'docker images'
        }
    }

    stage('Docker Login') {
        when {
            expression {
                env.BACKEND_CHANGED == "true"
            }
        }

        steps {
            withCredentials([
                usernamePassword(
                    credentialsId: 'DOCKER_HUB_TOKEN',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )
            ]) {
                sh '''
                    echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                '''
            }
        }
    }

    stage('Push Latest Image') {
        when {
            expression {
                env.BACKEND_CHANGED == "true"
            }
        }

        steps {
            sh 'docker push ${IMAGE_NAME}:latest'
        }
    }

    stage('Push Version Tag') {
        when {
            expression {
                env.BACKEND_CHANGED == "true"
            }
        }

        steps {
            sh 'docker push ${IMAGE_NAME}:${BUILD_NUMBER}'
        }
    }
}

post {
    success {
        echo 'Docker image pushed successfully'
    }

    failure {
        echo 'Pipeline failed'
    }
}
}
