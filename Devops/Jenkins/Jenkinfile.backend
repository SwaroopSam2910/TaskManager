pipeline {
    agent any

    environment{
        IMAGE_NAME = "swaroop2910/taskmanager-backend"
    }

    stages {

        stage('Workspace Check') {
            steps {
                sh 'pwd'
                sh 'ls -la'
            }
        }

        stage('Build Docker Image') { 
            steps { 
                sh '''
                docker build \
                -t ${IMAGE_NAME}:latest \
                -t ${IMAGE_NAME}:{BUILD_NUMBER} \
                ./product_backend
                '''
            } 
        }

        stage('Verify Image'){
            steps{
                sh 'docker images'
            }
        }

        stage('Docker Login'){
            steps{
                withCredentials([usernamePassword(credentialId: 'DOCKER_HUB_TOKEN',usernameVariable: 'DOCKER_USER',passwordVarible: 'DOCKER_PASS')]){  
                sh 'echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin'
                }
            }
        }

        stage('Push Latest Image'){
            steps{
                sh'docker push ${IMAGE_NAME}:latest'
            }
        }

        stage('Push Version Tag'){
            steps{
                sh'docker push ${IMAGE_NAME}:${BUILD_NUMBER}'
            }
        }
    }

    post{
        success{
            echo 'Docker image pussed successfully'
        }

        failer{
            echo 'Pipeline failed'
        }
    }
}